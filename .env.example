# SKAI Desktop Assistant Environment Configuration
# Copy this file to .env and adjust variables as needed

# Application Environment (development, production, testing)
ENVIRONMENT=production
DEBUG=false

# Server Network Configuration
HOST=127.0.0.1
PORT=8000

# Security and Secret Keys
SECRET_KEY=change_this_to_a_secure_random_hex_string
HMAC_SALT=SK_ENTERPRISES_SUMEET_KUMAR_SKAI_CORE_5_0

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Optional AI API Provider Keys (e.g. Gemini, OpenAI)
GEMINI_API_KEY=
OPENAI_API_KEY=
