{
  "name": "skai",
  "productName": "SKAI",
  "version": "0.0.1",
  "description": "SKAI — Powered by SK Enterprises. Local-First Holographic Voice & Desktop AI Assistant engineered by Sumeet Kumar.",
  "main": "dist-electron/main/index.js",
  "author": {
    "name": "Sumeet Kumar",
    "email": "sumeet.admin@skenterprises.ai",
    "url": "https://github.com/sumitkausik-oss/Project-SK-AI-4.0"
  },
  "license": "MIT",
  "scripts": {
    "dev": "tsc -p tsconfig.electron.json && concurrently -k \"vite\" \"cross-env NODE_ENV=development electron .\"",
    "start": "electron .",
    "build": "tsc && vite build && tsc -p tsconfig.electron.json",
    "build:win": "npm run dist:win",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "pack:win": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^12.4.7",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.1",
    "three": "^0.173.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.173.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "com.skenterprises.skai",
    "productName": "SKAI",
    "copyright": "Copyright © 2026 Sumeet Kumar | SK Enterprises. All Rights Reserved.",
    "forceCodeSigning": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/jarvis.ico",
      "artifactName": "SKAI_Setup_v${version}.${ext}",
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SKAI",
      "installerIcon": "assets/jarvis.ico",
      "uninstallerIcon": "assets/jarvis.ico",
      "uninstallDisplayName": "SKAI — Powered by SK Enterprises"
    }
  }
}
