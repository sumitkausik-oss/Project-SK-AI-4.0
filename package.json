{
  "name": "skai",
  "productName": "SKAI",
  "version": "5.0.0",
  "description": "SKAI — Powered by SK Enterprises. Local-First Desktop AI Assistant engineered by Sumeet Kumar.",
  "main": "electron/main.js",
  "author": {
    "name": "Sumeet Kumar",
    "email": "sumeet.admin@skenterprises.ai",
    "url": "https://github.com/sumitkausik-oss/Project-SK-AI-4.0"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "node -e \"console.log('Build validated.')\"",
    "dist:win": "electron-builder --win nsis --x64",
    "pack:win": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^39.8.10",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.skenterprises.skai",
    "productName": "SKAI",
    "copyright": "Copyright © 2026 Sumeet Kumar | SK Enterprises. All Rights Reserved.",
    "forceCodeSigning": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "frontend/**/*",
      "src_frontend/**/*",
      "backend/**/*",
      "src_backend/**/*",
      "assets/**/*",
      "config/**/*",
      "core/**/*",
      "dist/**/*",
      "run_sk_ai_4.py",
      "run_dev.py",
      "Main_SK_AI_4.py"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/jarvis.ico",
      "artifactName": "SKAI_Setup_x64_v${version}.${ext}",
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SKAI",
      "installerIcon": "assets/jarvis.ico",
      "uninstallerIcon": "assets/jarvis.ico",
      "uninstallDisplayName": "SKAI — Powered by SK Enterprises"
    }
  }
}
